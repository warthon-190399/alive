# Copia este archivo como .env.local y completa tus valores.
# .env.local está en .gitignore: nunca se sube a GitHub.

# Clave gratuita de CARTO para el mapa oscuro (https://carto.com/basemaps/apikey)
# Sin clave, el mapa usa OpenStreetMap oscurecido.
NEXT_PUBLIC_CARTO_API_KEY=

# Zona horaria (opcional, por defecto America/Lima)
# ALIVE_TZ=America/Lima
